{
  "expo": {
    "name": "Karta e Studentit Shkodër",
    "slug": "karta-studentit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9FC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vini01.kartastudentitapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Kamera përdoret nga bizneset partnere për të skanuar QR-në e Kartës së Studentit.",
        "NSLocationWhenInUseUsageDescription": "Vendndodhja përdoret vetëm kur kërkoni oferta dhe biznese afër jush.",
        "NSPhotoLibraryUsageDescription": "Fotot përdoren vetëm kur bashkëngjitni një screenshot ose foto në kërkesën për suport."
      }
    },
    "android": {
      "package": "com.vini01.kartastudentitapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Lejo aksesin te kamera për të përdorur skanerin e QR.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vendndodhja përdoret vetëm kur kërkoni oferta dhe biznese afër jush."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotot përdoren vetëm kur bashkëngjitni një screenshot ose foto në kërkesën për suport."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bd83788c-2c95-4a0f-a48c-64ae4d228727"
      }
    },
    "owner": "vini01"
  }
}
